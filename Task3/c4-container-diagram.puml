@startuml C4_Container_Diagram
!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

title C4 Container Diagram: Система открытия депозитов (MVP)

Person(new_client, "Новый клиент")
Person(existing_client, "Существующий клиент")

System_Boundary(deposit_boundary, "Система открытия депозитов") {
    Container(website, "Сайт банка", "PHP, React.js", "SPA для новых клиентов. Отображение продуктов, подача заявки")
    Container(inet_bank_legacy, "Интернет-банк (Legacy)", "ASP.NET MVC 4.5", "Монолитное приложение. Платежи, текущие счета")

    Container_Boundary(microservices, "Новые микросервисы") {
        Container(api_gateway, "API Gateway", ".NET Core", "Единая точка входа. Аутентификация, авторизация, маршрутизация")
        Container(deposit_service, "Deposit Service", ".NET Core", "Управление заявками на депозиты, бизнес-логика")
        Container(rate_service, "Rate Service", "Java Spring Boot", "Управление ставками по депозитам, персонализация")
        Container(notification_service, "Notification Service", ".NET Core", "Отправка СМС-уведомлений клиентам")

        ContainerDb(deposit_db, "Deposit DB", "MS SQL", "Хранилище заявок")
        ContainerDb(rate_db, "Rate DB", "PostgreSQL", "Хранилище ставок")

        ContainerQueue(kafka, "Apache Kafka", "Message Broker", "Асинхронная коммуникация между сервисами")
    }
}

System_Ext(cc_system, "Система кол-центра", "Обработка заявок операторами")
System(abs_system, "АБС", "Обработка и согласование в бэк-офисе")
System_Ext(sms_gateway, "СМС-шлюз", "Отправка СМС")

Rel(new_client, website, "Подает заявку", "HTTPS")
Rel(existing_client, inet_bank_legacy, "Подает заявку", "HTTPS")

Rel(website, api_gateway, "API запросы", "HTTPS/JSON")
Rel(inet_bank_legacy, api_gateway, "API запросы", "HTTPS/JSON")

Rel(api_gateway, deposit_service, "Маршрутизация")
Rel(api_gateway, rate_service, "Получение ставок")

Rel(deposit_service, deposit_db, "Сохранение заявок", "SQL")
Rel(rate_service, rate_db, "Чтение/запись ставок", "SQL")

Rel(deposit_service, kafka, "Публикация событий (заявки, уведомления)")
Rel(rate_service, kafka, "Публикация событий (изменение ставок)")
Rel(kafka, notification_service, "Подписка на события (уведомления)")

Rel(kafka, cc_system, "Передача заявок от новых клиентов")
Rel(kafka, abs_system, "Передача заявок на обработку")
Rel(abs_system, kafka, "События об изменении статуса заявки", "async")

Rel(notification_service, sms_gateway, "Отправка СМС", "REST API")

@enduml
